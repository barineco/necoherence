{
  "name": "necoherence-tools",
  "version": "0.2.0",
  "description": "Code generators for necoherence",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --project tsconfig.json --strict --noEmit",
    "test": "vitest run --fileParallelism=false"
  },
  "dependencies": {
    "necoherence": "file:../../typescript"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "fast-check": "^3.23.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
