{
  "name": "necoherence-http-adapter",
  "version": "0.3.0",
  "description": "HTTP host adapter for Necoherence",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "lint": "eslint src",
    "pretest": "npm run build",
    "test": "vitest run --fileParallelism=false"
  },
  "peerDependencies": {
    "necoherence": "0.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "eslint": "^9.39.5",
    "necoherence": "file:..",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^2.1.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/barineco/necoherence.git",
    "directory": "packages/typescript/adapter/http"
  },
  "homepage": "https://github.com/barineco/necoherence",
  "bugs": {
    "url": "https://github.com/barineco/necoherence/issues"
  }
}
