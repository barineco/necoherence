{
  "name": "necoherence-http-adapter",
  "version": "0.2.1",
  "description": "HTTP host adapter for Necoherence",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "README-ja.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "pretest": "npm run build",
    "test": "vitest run --fileParallelism=false"
  },
  "peerDependencies": {
    "necoherence": "0.2.1"
  },
  "devDependencies": {
    "necoherence": "file:../typescript",
    "@types/node": "^26.1.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/barineco/necoherence.git",
    "directory": "typescript-http-adapter"
  },
  "homepage": "https://github.com/barineco/necoherence",
  "bugs": {
    "url": "https://github.com/barineco/necoherence/issues"
  }
}
